{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug (F405)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/CM4_stm32.elf", 
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "D:/msys64/mingw64/bin/openocd.exe",
            // "interface": "swd",
            
            // --- 核心启动逻辑（解决 F5 失败和 while 循环问题） ---
            "runToEntryPoint": "main", 
            "postStartSessionCommands": [
                "continue" 
            ],

            // --- 工具链路径 ---
            "gdbPath": "D:/arm-none-eabi-gcc/arm-gnu-toolchain-15.2.rel1-mingw-w64-i686-arm-none-eabi/bin/arm-none-eabi-gdb.exe",
            
            "debuggerArgs": [
                "-ex", "set pagination off",
                "-ex", "set confirm off",
            ],
            
            "showDevDebugOutput": "raw",
            
            // --- F405 专用硬件配置 ---
            "device": "STM32F405RG", // 根据具体型号可能是 RG, VG 等
            "configFiles": [
                "D:/msys64/mingw64/share/openocd/scripts/interface/stlink.cfg",
                "D:/msys64/mingw64/share/openocd/scripts/target/stm32f4x.cfg"  // 注意：F405 对应的是 f4x
            ],
           
            // 如果有 F405 的 SVD 文件，修改此处路径
            "svdFile": "${workspaceFolder}/STM32F405.svd"
        }
    ]
}